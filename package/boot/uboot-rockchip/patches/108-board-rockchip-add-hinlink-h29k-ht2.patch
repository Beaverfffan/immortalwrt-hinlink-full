+		};
+
+		sdmmc_vol_ctrl_h: sdmmc-vol-ctrl-h {
+			rockchip,pins = <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+/* vdd_arm / vdd_logic 由 PWM 控制，U-Boot 需要它们才能跑起来 */
+&pwm1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm1m0_pins>;
+	status = "okay";
+};
+
+&pwm2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm2m0_pins>;
+	status = "okay";
+};
+
+/* 板载 eMMC（8 bit，non-removable）—— 与 H28K 一致 */
+&sdhci {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	non-removable;
+	vmmc-supply = <&vcc_3v3>;
+	vqmmc-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+/* TF 卡槽（4 bit）—— 与 H28K 一致 */
+&sdmmc {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr104;
+	vmmc-supply = <&vcc3v3_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	status = "okay";
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0m0_xfer>;
+	status = "okay";
+};
--- /dev/null
+++ b/arch/arm/dts/rk3528-hinlink-ht2-u-boot.dtsi
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * HINLINK OPC-HT2 —— U-Boot overlay
+ *
+ * U-Boot 启动时把 ARM / LOGIC 两路 PWM 供电先设到安全中间值，
+ * 之后由内核接管调频。数值沿用 H28K（同为 HinLink RK3528 板，
+ * 三款的 vdd_arm / vdd_logic 范围完全一致：746000~1201000 / 705000~1006000）。
+ */
+
+#include "rk3528-u-boot.dtsi"
+
+&vdd_arm {
+	regulator-init-microvolt = <953000>;
+};
+
+&vdd_logic {
+	regulator-init-microvolt = <900000>;
+};
