# HinLink 固件的 fancontrol 默认配置
#
# ★ 与上游的差别只有一处：enabled 从 '0' 改成 '1'。
#   上游默认是「装了但不开」，本固件要求**开箱即用**：H 系列机箱风扇
#   直接按温度曲线跑（45 °C 起转、85 °C 满速），用户不需要进 LuCI 点一下。
#
# 其余参数沿用上游默认：
#   · thermal_file / thermal_zone / fan_file / fan_hwmon / enable_file 全是 'auto'
#     —— 由 fancontrol 自己扫 hwmon ABI 找温度源与 pwm 风扇（RK35xx 上
#        是 pwm-fan + 内置 thermal zone），不需要按机型硬编码路径；
#   · start_temp 45 / full_speed_temp 85 / hysteresis 3：起转与满速之间
#     有 40 °C 的线性区间，3 °C 回差防抖；
#   · kick_speed 255 + kick_ms 500：起步先给满速脉冲，避免低速启动堵转；
#   · fail_safe_speed 255：温度读不到就全速（宁可吵，不可烧）；
#   · temp_div 1000：hwmon 上报的是毫摄氏度。
#
# 想改成恒速或关掉温控：LuCI「服务 → Fan Control」，或直接编辑本文件后
# /etc/init.d/fancontrol restart。

config fancontrol 'settings'
	option enabled '1'
	option thermal_file 'auto'
	option thermal_zone 'auto'
	option fan_file 'auto'
	option fan_hwmon 'auto'
	option enable_file 'auto'
	option start_temp '45'
	option full_speed_temp '85'
	option hysteresis '3'
	option start_speed '64'
	option max_speed '255'
	option kick_speed '255'
	option kick_ms '500'
	option fail_safe_speed '255'
	option exit_speed '255'
	option temp_div '1000'
	option interval '5'
	option debug '0'
