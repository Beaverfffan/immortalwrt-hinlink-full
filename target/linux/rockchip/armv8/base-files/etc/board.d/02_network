
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

rockchip_setup_interfaces()
{
	local board="$1"

	case "$board" in
	9tripod,x3568-v4|\
	ariaboard,photonicat|\
	ariaboard,photonicat2|\
	armsom,sige7|\
	ezpro,mrkaio-m68s|\
	firefly,rk3568-roc-pc|\
	friendlyarm,nanopi-m5|\
	friendlyarm,nanopi-r2c|\
	friendlyarm,nanopi-r2c-plus|\
	friendlyarm,nanopi-r2s|\
	friendlyarm,nanopi-r2s-plus|\
	friendlyarm,nanopi-r3s|\
	friendlyarm,nanopi-r4s|\
	friendlyarm,nanopi-r4se|\
	friendlyarm,nanopi-r4s-enterprise|\
	friendlyarm,nanopi-r6c|\
	graperain,g3568-v2|\
	radxa,rockpi-e|\
	xunlong,orangepi-r1-plus|\
	xunlong,orangepi-r1-plus-lts)
		ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
		;;
	armsom,sige3|\
	friendlyarm,nanopi-r5c|\
	friendlyarm,nanopi-r76s|\
	lunzn,fastrhino-r66s|\
	mmbox,anas3035|\
	nlnet,xiguapi-v3|\
	radxa,e20c|\
	radxa,e25|\
	radxa,rock-3b|\
	widora,mangopi-m28k|\
	xunlong,orangepi-5-plus)
		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
		;;
	cyber,cyber3588-aib)
		ucidef_set_interfaces_lan_wan 'lan1' 'wan'
		;;
	friendlyarm,nanopc-t6)
		ucidef_set_interfaces_lan_wan 'eth1' 'eth2'
		;;
	friendlyarm,nanopi-r5s)
		ucidef_set_interfaces_lan_wan 'eth1 eth2' 'eth0'
		;;
	friendlyarm,nanopi-r6s)
		ucidef_set_interfaces_lan_wan 'eth0 eth1' 'eth2'
		;;
	lunzn,fastrhino-r68s)
		ucidef_set_interfaces_lan_wan 'eth0 eth1 eth2' 'eth3'
		;;
	lyt,t68m)
		ucidef_set_interfaces_lan_wan 'lan2 lan3 lan4' 'lan1'
		;;
	linkease,easepi-r1)
		ucidef_set_network_device_path eth2 'platform/3c0400000.pcie/pci0001:10/0001:10:00.0/0001:11:00.0'
		ucidef_set_network_device_path eth3 'platform/3c0000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
		ucidef_set_interfaces_lan_wan 'eth1 eth2 eth3' 'eth0'
		;;
	radxa,e52c)
		ucidef_set_network_device_path 'wan' 'platform/a40c00000.pcie/pci0003:30/0003:30:00.0/0003:31:00.0'
		ucidef_set_network_device_path 'lan' 'platform/a41000000.pcie/pci0004:40/0004:40:00.0/0004:41:00.0'
		ucidef_set_interfaces_lan_wan 'lan' 'wan'
		;;
	radxa,rock-5-itx)
		ucidef_set_network_device_path 'eth0' 'platform/a40c00000.pcie/pci0003:30/0003:30:00.0/0003:31:00.0'
		ucidef_set_network_device_path 'eth1' 'platform/a41000000.pcie/pci0004:40/0004:40:00.0/0004:41:00.0'
		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
		;;
	radxa,rock-5t)
		ucidef_set_network_device_path 'eth1' 'platform/a40c00000.pcie/pci0003:30/0003:30:00.0/0003:31:00.0'
		ucidef_set_network_device_path 'eth0' 'platform/a41000000.pcie/pci0004:40/0004:40:00.0/0004:41:00.0'
		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
		;;
	sinovoip,rk3568-bpi-r2pro)
		ucidef_set_interfaces_lan_wan 'lan0 lan1 lan2 lan3' 'eth0'
		;;
		# ======================= RK3568 =======================

		# ---- H68K a-b（2022 双千兆，仅 2 口）：WAN = eth0 ----
		# 2026-10-12 改名：h68k-a / h68k-a-usb → h68k-a-b / h68k-a-b-usb
		# （旧 compatible 保留在下面，旧 DTB / 厂商写的 board.d 仍能匹配）
		hinlink,opc-h68k-a-b|\
		hinlink,opc-h68k-a-b-usb|\
		hinlink,opc-h68k-a|\
		hinlink,opc-h68k-a-usb|\
		linkstar,opc-h68k-a)
			ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
			;;

		# ---- H68K c-d-f（2022~2023.4 四网口，2×RTL8125）：WAN = eth0 ----
		# 旧版这里写的是 WAN=eth1（照抄 2022 厂商固件），实机反馈 c 是 WAN=eth0，
		# 2026-10-12 更正。四网口机型统一 LAN=eth1 eth2 eth3 / WAN=eth0。
		# 同日把 c / d 与 c-usb3 / d-usb 合并为 c-d-f / c-d-f-usb 两个机型，
		# 旧 compatible 全部保留在下面。
		hinlink,opc-h68k-c-d-f|\
		hinlink,opc-h68k-c-d-f-usb|\
		hinlink,opc-h68k-c|\
		hinlink,opc-h68k-c-usb|\
		hinlink,opc-h68k-c-usb3|\
		hinlink,opc-h68k-d|\
		hinlink,opc-h68k-d-usb|\
		linkstar,opc-h68k-c|\
		linkstar,opc-h68k-d|\
		hinlink,h68k|\
		linkstar,h68k)
			ucidef_set_interfaces_lan_wan 'eth1 eth2 eth3' 'eth0'
			;;

		# ---- H68K new（2023末~2024）：新一代，WAN 在 gmac1 ----
		#   两个 GMAC 都开 ⇒ gmac0=eth0、gmac1=eth1 ⇒ WAN = eth1
		hinlink,opc-h68k-new)
			ucidef_set_interfaces_lan_wan 'eth0 eth2 eth3' 'eth1'
			;;

		# ---- H69K（三网口）：gmac0 被 disabled，只剩 gmac1 → 枚举成 eth0 ----
		#   gmac1 = eth0（板载），2×PCIe 2.5G = eth1/eth2
		#   ★ 新一代的 WAN 都接在 gmac1 上 ⇒ 本机 WAN = eth0（因为 gmac1 就是 eth0）
		hinlink,opc-h69k|\
		hinlink,h69k)
			ucidef_set_interfaces_lan_wan 'eth1 eth2' 'eth0'
			;;

		# ---- H69K-mini（四网口 = H68K max）----
		#   ★ 与 H69K 三网口版的关键差别：这里 gmac0 **也开着**
		#     ⇒ gmac0 = eth0、gmac1 = eth1，2×PCIe 2.5G = eth2/eth3
		#   ★ 与 h68k-new 同一代、同一网络构成（2×GMAC + 2×RTL8125）
		#     ⇒ 按「新一代 WAN = gmac1」的同一逻辑，WAN = **eth1**
		#   （2026-10-12 更正：原来抄成 LAN eth1 eth2 eth3 / WAN eth0）
		hinlink,opc-h69k-mini)
			ucidef_set_interfaces_lan_wan 'eth0 eth2 eth3' 'eth1'
			;;

		# ---- H66K：两个 GMAC 都 disabled（厂商 2024 dtb 实证），
		#      只有 2 路 PCIe RTL8125 ⇒ eth0/eth1 都是 PCIe 口 ----
		hinlink,opc-h66k|\
		hinlink,h66k)
			ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
			;;

		# ======================= RK3528 =======================

		# ---- H28K：双口 ----
		#   eth0 = 板载 RTL8211F RGMII 千兆（gmac1）
		#   eth1 = PCIe RTL8111H 千兆（PCI 枚举产生，DT 里不写网卡节点）
		hinlink,opc-h28k|\
		hinlink,h28k|\
		hlink,h28k|\
		linkstar,h28k|\
		linkstar,opc-h28k)
			ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
			;;

		# ---- H29K 全系：单口（厂商 dtb 实证 gmac0 disabled、无 PCIe 网卡）----
		hinlink,opc-h29k|\
		hinlink,h29k|\
		hinlink,h29k-v1.3-114|\
		hinlink,h29k-v1.3-1.14|\
		hinlink,h29k-v5-114|\
		hinlink,h29k-v5-1.14|\
		hinlink,h29k-v5-149|\
		hinlink,h29k-v5-1.49)
			ucidef_set_interfaces_lan_wan 'eth0'
			;;

		# ---- HT2：单口（厂商 dtb 实证 gmac1、无 PCIe 网卡）----
		hinlink,opc-ht2|\
		hinlink,ht2|\
		hlink,ht2)
			ucidef_set_interfaces_lan_wan 'eth0'
			;;

		# ======================= RK3588 =======================

		# ---- H88K v2：两网口（gmac0=eth0 + pcie2x1l1=eth1）----
		# pcie3x4 是 PCIe x4 插槽位（插扩展网卡/NVMe），不算板载口
		hinlink,h88k-v2)
			ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
			;;

		# ---- H88K v3：三网口（v2 两口 + pcie2x1l2 第三颗 RTL8125）----
		hinlink,h88k-v3)
			ucidef_set_interfaces_lan_wan 'eth1 eth2' 'eth0'
			;;

		# ---- H89K：三口（gmac0=eth0 + 2×RTL8125=eth1/eth2）----
		# 厂商固件 02_network 原值：hinlink,h89k -> LAN "eth0 eth1" / WAN "eth2"
		hinlink,opc-h89k|\
		hinlink,h89k)
			ucidef_set_interfaces_lan_wan 'eth0 eth1' 'eth2'
			;;

	*)
		ucidef_set_interface_lan 'eth0'
		;;
	esac
}

rockchip_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	ariaboard,photonicat2|\
	armsom,sige3|\
	armsom,sige7|\
	cyber,cyber3588-aib|\
	ezpro,mrkaio-m68s|\
	friendlyarm,nanopc-t6|\
	friendlyarm,nanopi-m5|\
	friendlyarm,nanopi-r2c|\
	friendlyarm,nanopi-r2s|\
	friendlyarm,nanopi-r76s|\
	linkease,easepi-r1|\
	lunzn,fastrhino-r66s|\
	lunzn,fastrhino-r68s|\
	nlnet,xiguapi-v3|\
	mmbox,anas3035)
		wan_mac=$(macaddr_generate_from_mmc_cid mmcblk0)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		;;
	friendlyarm,nanopi-r2c-plus|\
	friendlyarm,nanopi-r2s-plus|\
	friendlyarm,nanopi-r4s|\
	friendlyarm,nanopi-r5s|\
	friendlyarm,nanopi-r6s|\
	sinovoip,rk3568-bpi-r2pro)
		wan_mac=$(macaddr_generate_from_mmc_cid mmcblk1)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		;;
	friendlyarm,nanopi-r3s|\
	friendlyarm,nanopi-r5c|\
	friendlyarm,nanopi-r6c|\
	widora,mangopi-m28k|\
	xunlong,orangepi-5-plus)
		wan_mac=$(macaddr_generate_from_mmc_cid mmcblk*)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		;;
	friendlyarm,nanopi-r4se)
		wan_mac=$(macaddr_generate_from_mmc_cid mmcblk2)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		;;
	friendlyarm,nanopi-r4s-enterprise)
		wan_mac=$(get_mac_binary "/sys/bus/i2c/devices/2-0051/eeprom" 0xfa)
		lan_mac=$(macaddr_setbit_la "$wan_mac")
		;;
	xunlong,orangepi-r1-plus|\
	xunlong,orangepi-r1-plus-lts)
		lan_mac=$(cat /sys/class/net/eth1/address)
		wan_mac=$(macaddr_add "$lan_mac" -1)
		;;
		# ---- 全部 HinLink 机型：从 eMMC 的 CID 生成稳定 MAC ----
		#   mmcblk0 必须是 **eMMC**（见各 DTS 的 mmc0 alias），
		#   否则会拿 TF 卡的 CID，换卡就换 MAC。
		hinlink,opc-h68k-a-b|\
		hinlink,opc-h68k-a-b-usb|\
		hinlink,opc-h68k-c-d-f|\
		hinlink,opc-h68k-c-d-f-usb|\
		hinlink,opc-h68k-a|\
		hinlink,opc-h68k-a-usb|\
		hinlink,opc-h68k-c|\
		hinlink,opc-h68k-c-usb|\
		hinlink,opc-h68k-c-usb3|\
		hinlink,opc-h68k-d|\
		hinlink,opc-h68k-d-usb|\
		hinlink,opc-h68k-new|\
		hinlink,opc-h69k|\
		hinlink,opc-h69k-mini|\
		hinlink,opc-h66k|\
		hinlink,h66k|\
		hinlink,h68k|\
		linkstar,h68k|\
		hinlink,opc-h28k|\
		hinlink,h28k|\
		hlink,h28k|\
		linkstar,h28k|\
		hinlink,opc-h29k|\
		hinlink,h29k|\
		hinlink,h29k-v1.3-114|\
		hinlink,h29k-v5-114|\
		hinlink,h29k-v5-149|\
		hinlink,opc-ht2|\
		hinlink,ht2|\
		hlink,ht2|\
		hinlink,h88k-v2|\
		hinlink,h88k-v3|\
		hinlink,opc-h89k|\
		hinlink,h89k)
			wan_mac=$(macaddr_generate_from_mmc_cid mmcblk0)
			lan_mac=$(macaddr_add "$wan_mac" 1)
			;;

	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac
	[ -n "$label_mac" ] && ucidef_set_label_macaddr $label_mac
}

board_config_update
board=$(board_name)
rockchip_setup_interfaces $board
rockchip_setup_macs $board
board_config_flush

exit 0
