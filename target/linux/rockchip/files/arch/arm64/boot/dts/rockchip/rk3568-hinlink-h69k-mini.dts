// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * HinLink OPC-H69K (5G)
 *
 * HinLink 适配for immortalwrt —— 每机型独立 DTS，不做自适应。
 *
 * 硬件事实来源：厂商 2024 QWRT R24.07.07 固件 dtb（已解包反编译逐项核对）
 * 蓝本：OpenWrt 主线 rk3568-hinlink-h68k.dts
 *
 * 真·69K：装 USB 5G 模组；屏蔽 1 个 GMAC → 1×GMAC + 2×RTL8125 = 3 口
 */

/dts-v1/;

#include <dt-bindings/thermal/thermal.h>
#include "rk3568-hinlink-opc.dtsi"

/ {
	model = "HinLink OPC-H69K (5G)";
	compatible = "hinlink,opc-h69k-mini", "hinlink,h69k", "hinlink,h69k-mini", "hinlink,h68k", "rockchip,rk3568";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
	};
};
&gmac0 {
	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	clock_in_out = "output";
	phy-mode = "rgmii-id";
	phy-supply = <&vcc3v3_sys>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
		     &gmac0_tx_bus2
		     &gmac0_rx_bus2
		     &gmac0_rgmii_clk
		     &gmac0_rgmii_bus
		     &gmac0_rstn>;
	snps,reset-gpios = <&gpio2 RK_PD3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	tx_delay = <0x3c>;
	rx_delay = <0x2f>;
	phy-handle = <&rgmii_phy0>;
	status = "okay";
};

&gmac1 {
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	clock_in_out = "output";
	phy-mode = "rgmii-id";
	phy-supply = <&vcc3v3_sys>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m1_miim
		     &gmac1m1_tx_bus2
		     &gmac1m1_rx_bus2
		     &gmac1m1_rgmii_clk
		     &gmac1m1_rgmii_bus
		     &gmac1_rstn>;
	snps,reset-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	tx_delay = <0x4f>;
	rx_delay = <0x26>;
	phy-handle = <&rgmii_phy1>;
	status = "okay";
};

&mdio0 {
	rgmii_phy0: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&mdio1 {
	rgmii_phy1: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&{/} {
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk809 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable>;
		post-power-on-delay-ms = <200>;
		power-off-delay-us = <5000000>;
		reset-gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
	};
};

&{/} {
	vcc3v3_sd_pwr: vcc3v3-sd-pwr {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc3v3_sd_pwr_en>;
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "vcc3v3_sd_pwr";
		vin-supply = <&vcc5v0_sys>;
	};
};

&sdmmc2 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	disable-wp;
	keep-power-in-suspend;
	max-frequency = <15000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc2m0_bus4 &sdmmc2m0_cmd &sdmmc2m0_clk>;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	status = "okay";
	vmmc-supply = <&vcc3v3_sys>;
	vqmmc-supply = <&vcc3v3_sd_pwr>;

	sdio_wifi: sdio-wifi@0 {
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PD4 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
		reg = <0>;
	};
};

/*
 * ★ 原&rk809 { ext_32k_clk_out { rockchip,grf = <&rk809_grf 0>; } } 已删除
 *
 *   原因：Linux 6.18 的 rk3568 SoC dtsi 里**没有 rk809 节点，也没有 rk809_grf
 *   标签**（6.18 已把 SoC 拆分到 rk356x-base.dtsi，RK809 PMIC 不在其中）。
 *   保留这段会因 phandle 找不到而**编译失败**。
 *
 *   佐证：6.18 内核自带的 rk3568-hinlink-h68k.dts（官方蓝本）也没有这段。
 *   而本仓库的 rk3568-hinlink-opc.dtsi 与 6.18 内核自带的同名文件
 *   **sha256 完全一致**，说明这份 dtsi 已是上游官方版本 ——
 *   上游没引用 rk809_grf，说明它确实不需要。
 *
 *   这个 32.768kHz 时钟输出是给 RTC 用的；RK3568 板载 RTC 走
 *   hym8563（I2C），不依赖 RK809。若你的机器确实需要它，
 *   应改用 `rk809` 相关的正确写法或另找时钟源。
 */


&pinctrl {
	sdmmc {
		vcc3v3_sd_pwr_en: vcc3v3-sd-pwr-en {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		/*
		 * ★ sdmmc2m0_bus4 / _cmd / _clk 的定义**已删除**：
		 *   内核 rk3568-pinctrl.dtsi 已提供同名标签，内容与我们逐项相同
		 *   （如 <3 RK_PC6 3 &pcfg_pull_up_drv_level_2>），重定义会报
		 *   duplicate_label。&sdmmc2 的 pinctrl-0 照常引用内核定义。
		 */

	};

	wifi {
		wifi_enable: wifi-enable {
			rockchip,pins = <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&{/} {
	/*
	 * ============ 5G 模组供电/复位 —— GPIO0_C0，3.3V ============
	 *
	 * 来源：iStoreOS rk3568-opc-h69k.dts 与厂商 2024 QWRT 固件 dtb
	 * （fw24/dtb/dtb_3245000.dtb，model="HINLINK OPC-H69K Board"）。
	 * 厂商 dtb 原文：
	 *
	 *     modem-enable-regulator {
	 *         compatible = "regulator-fixed";
	 *         regulator-name = "modem_enable";
	 *         gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
	 *         startup-delay-us = <0x1e8480>;        // 2 秒
	 *         // ★ 注意：没有 enable-active-high
	 *     };
	 *
	 * ★★ 极性只由 `enable-active-high` 决定，不能凭 GPIO_ACTIVE_LOW 猜 ★★
	 *   6.18 的 drivers/gpio/gpiolib-of.c 里有一张极性映射表，注释原文：
	 *     "The regulator GPIO handles are specified such that the presence
	 *      or absence of enable-active-high solely controls the polarity of
	 *      the GPIO line. Any phandle flags must be actively ignored."
	 *   即：对 regulator-fixed 的 gpio/gpios，DT 里写的 GPIO_ACTIVE_LOW /
	 *   GPIO_ACTIVE_HIGH **被内核主动忽略**，只看有没有 enable-active-high：
	 *         有 → 高电平使能
	 *         无 → 低电平使能   ← 厂商原意（本节点）
	 *
	 * ⚠️ 历史 bug（2026-10-12 修）：旧版这里多写了 `enable-active-high;`，
	 *   于是按规则变成**高电平使能**，内核开机把 GPIO0_C0 拉**高**，
	 *   而模组要**低**才供电 ⇒ H69K-mini 的 5G 模组从没被上电过。
	 *
	 * ★ startup-delay-us = 2 秒：模组上电后需要时间稳定。
	 * ⚠️ 不要另加 rfkill-gpio 指向 GPIO0_C0，同一个脚两个驱动会打架。
	 *   详见 docs/HARDWARE.md §四。
	 */
	/*
	 * ============ 5G 模组「供电 + 复位」单路开关 —— 交给 rfkill-gpio ============
	 *
	 * H69K-mini 与 H69K 一样只有这**一个** GPIO（GPIO0_C0）。
	 * 改用 rfkill-gpio 后既能保证开机上电、又能软复位：
	 *
	 *   · 开机：rfkill 默认 unblocked → gpiod_set_value(1)
	 *     →（GPIO_ACTIVE_LOW）物理低 = 使能/工作 ⇒ 模组上电 ✓
	 *   · 运行时：`echo 0 > /sys/class/rfkill/rfkillN/state` → 物理高
	 *     = 断电/复位 ⇒ `echo 1` 恢复 = 一次真正的断电重启 ✓
	 *
	 *   6.18 net/rfkill/core.c 的 `DEVICE_ATTR_RW(state)` 就是入口，
	 *   **不需要装 rfkill 命令**（纯 sysfs）。已封装为
	 *   `/etc/init.d/hinlink-modem-hardreset reset`。
	 *
	 * ★ 代价：丢掉 regulator 的 `startup-delay-us = 2s`（rfkill-gpio 无
	 *   延时机制），改由 hinlink-modem-hardreset 脚本复位后等待。
	 * ★ 时序更早：rfkill-gpio 在 device_initcall 就定电平，
	 *   早于原 regulator 的 late_initcall_sync。
	 *
	 * ⚠️ 属性名必须是 `label` + `radio-type`（6.18 的 DT 路径只读这两个）。
	 * ⚠️ 不要再写 `power-gpios`（6.18 无实现）。
	 */
	rfkill-modem {
		compatible = "rfkill-gpio";
		label = "rfkill-modem";
		radio-type = "wwan";
		reset-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&modem_enable_en>;
	};

	/*
	 * ★★ 风扇：PWM0 驱动 pwm-fan，绑定 cpu_thermal
	 *
	 * 参数全部来自 iStoreOS 官方 rk3568-opc-h69k.dts，
	 * 并由「h69k-fan」LuCI 插件的 DEVELOPMENT.md 反向验证：
	 *   「pwm-fan cooling-levels = <0 0x55 0x66 0x77 0x88 0x99 0xbb 0xcc 0xff>
	 *     —— 即 0/33/40/47/53/60/73/80/100%，
	 *     与本插件 pct_to_state 的 9 档映射逐值一致」
	 *
	 * ★ cooling-levels 的 9 个值不是随便填的，它就是 h69k-fan 插件
	 *   的 pct_to_state 映射表。改这里会让插件的档位错位。
	 * ★ 风扇绑定 cpu_thermal；设备树无 tach 引脚 → 无 RPM 反馈。
	 *
	 * ⚠️ H69K-mini 是 4 口版（= H68K max），风扇与 H69K 三口版相同。
	 */
	fan: pwm-fan {
		compatible = "pwm-fan";
		cooling-levels = <0 0x55 0x66 0x77 0x88 0x99 0xbb 0xcc 0xff>;
		#cooling-cells = <2>;
		fan-supply = <&vcc5v0_sys>;
		pwms = <&pwm0 0 50000 0>;
	};
};

/* 风扇 PWM 通道 */
&pwm0 {
	status = "okay";
};

/*
 * CPU 温控曲线 —— 挂在 fan 上
 *   20℃ passive -> 最低档    65℃ -> 2~4 档
 *   85℃ -> 4~6 档    95℃ -> 6 档以上（满档）
 *
 * ⚠️ 内核 rk356x-base.dtsi 原本的 cpu_thermal 只有 passive 的
 *   cpu_alert0(70℃)/cpu_alert1(75℃) + critical(95℃)，
 *   cooling-map0绑的是 CPU（CPU_FREQ_INCREASE）不是风扇。
 *   下面覆盖为风扇曲线。
 */
&cpu_thermal {
	trips {
		cpu_warm: cpu_warm {
			temperature = <65000>;
			hysteresis = <5000>;
			type = "active";
		};

		cpu_hot: cpu_hot {
			temperature = <85000>;
			hysteresis = <5000>;
			type = "active";
		};

		cpu_hall: cpu_hall {
			temperature = <95000>;
			hysteresis = <5000>;
			type = "active";
		};

		cpu_idle: cpu_idle {
			temperature = <20000>;
			hysteresis = <3000>;
			type = "passive";
		};
	};

	cooling-maps {
		map2 {
			trip = <&cpu_idle>;
			cooling-device = <&fan THERMAL_NO_LIMIT 2>;
		};

		map3 {
			trip = <&cpu_warm>;
			cooling-device = <&fan 2 4>;
		};

		map4 {
			trip = <&cpu_hot>;
			cooling-device = <&fan 4 6>;
		};

		map5 {
			trip = <&cpu_hall>;
			cooling-device = <&fan 6 THERMAL_NO_LIMIT>;
		};
	};
};


&pinctrl {
	modem {
		modem_enable_en: modem-enable-en {
			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	gmac {
		gmac0_rstn: gmac0-rstn {
			rockchip,pins = <2 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		gmac1_rstn: gmac1-rstn {
			rockchip,pins = <1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
